# Set these in the seller server environment. Never put actual secrets in website/.
SALES_ENABLED=false
SALES_ORIGIN=http://127.0.0.1:5080
SALES_DB=data/sales/orders.sqlite
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Stripe API version so behaviour cannot drift when the account
# default changes. Leave empty to use the account/SDK default (e.g. 2025-08-27.basil).
STRIPE_API_VERSION=
RESEND_API_KEY=
SALES_FROM=
LICENSE_PRIVATE_KEY_PATH=keys/ed25519_private.pem
