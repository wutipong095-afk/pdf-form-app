# Seller checkout only. Do not use for the desktop/Windows build.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-sales-cloud.txt .
RUN pip install --no-cache-dir -r requirements-sales-cloud.txt

COPY sales_service.py license_core.py envutil.py i18n_core.py ./
COPY locales ./locales
COPY website ./website

RUN mkdir -p /data

ENV SALES_DB=/data/orders.sqlite \
    PORT=8080

EXPOSE 8080

# Run as root so a Railway volume mounted at /data is writable.
# gunicorn 26 needs --factory; sales_service:create_app() without it exits immediately.
CMD ["sh", "-c", "mkdir -p /data && gunicorn -b 0.0.0.0:${PORT:-8080} -w 1 --timeout 60 --factory sales_service:create_app"]
