# Caddy example — formdd.xambrain.com
# วางเป็นไซต์แยก อย่าทับ config ของ shed.xambrain.com
#
# /var/www/formdd ใส่ได้เฉพาะของสาธารณะ:
#   HTML / CSS / JS / รูป / FormDD-Setup-x.y.z.exe / latest.json / SHA256SUMS.txt
# ห้ามวางในโฟลเดอร์นี้:
#   private key, license-master.key, gen_license.py, .env, ฐานข้อมูลลูกค้า
# คีย์ออกไลเซนต์อยู่ที่ backend (env/secret) เช่น api.formdd.xambrain.com ในอนาคต

formdd.xambrain.com {
	root * /var/www/formdd
	file_server
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# แอปและเว็บใช้ไฟล์นี้ตรวจอัปเดต — ห้ามแคชนาน
	@latest path /releases/latest.json
	header @latest Cache-Control "no-cache"

	# ไฟล์ตามเวอร์ชันเป็น immutable — ห้ามทับ FormDD-Setup-x.y.z.exe เดิม
	@setup path /releases/*.exe
	header @setup Cache-Control "public, max-age=31536000, immutable"
}
